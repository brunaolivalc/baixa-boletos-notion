# Sankhya (API Gateway) - mesma credencial dos outros projetos da LC
SANKHYA_X_TOKEN=
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=

# Notion: token da integração (começa com ntn_)
NOTION_TOKEN=
# Fonte de dados da base "Posição de Cobrança" (também aceita o link da base)
NOTION_DATABASE=4139fe7c-432e-8030-8124-000b7a7d778b
# Fonte de dados da base por cliente (seção 7 do roteiro)
NOTION_CLIENTES=41f9fe7c-432e-81bf-90e3-000ba27aa0e8

# Empresas do Sankhya que entram
EMPRESAS=1,2,3,4,5,6,7,8,9

# Títulos: entra tudo que venceu até ontem (data de Brasília). Opcionais (vazio = sem filtro):
# Não trazer títulos vencidos há mais de X dias (ex.: 365)
DIAS_ATRASO_MAXIMO=
# Só estes tipos de título (CODTIPTIT), ex.: 4,19,29
TIPOS_TITULO=
# Ignorar estes tipos de título (CODTIPTIT)
TIPOS_TITULO_IGNORAR=
# Ignorar estes parceiros (CODPARC). 4262 = REDECARD
PARCEIROS_IGNORAR=4262

# Sucata: entra o cliente devendo mais que X kg (0 = qualquer saldo negativo)
SUCATA_SALDO_MINIMO_KG=10
