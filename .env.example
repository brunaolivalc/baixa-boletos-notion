# Sankhya (API Gateway) - mesma credencial dos outros projetos da LC
SANKHYA_X_TOKEN=
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=

# Notion: token da integração (começa com ntn_) e ID da fonte de dados da base
# (o roteiro usa 4139fe7c-432e-8030-8124-000b7a7d778b; também aceita o link da base)
NOTION_TOKEN=
NOTION_DATABASE=4139fe7c-432e-8030-8124-000b7a7d778b

# Empresas do Sankhya que entram
EMPRESAS=1,2,3,4,5,6,7,8,9

# Entra no Notion o título vencido há MAIS de X dias (7 = a partir do 8º dia)
DIAS_ATRASO=7

# Opcionais (deixe vazio para não filtrar)
# Não trazer títulos vencidos há mais de X dias (ex.: 365)
DIAS_ATRASO_MAXIMO=
# Só estes tipos de título (CODTIPTIT), ex.: 4,19,29
TIPOS_TITULO=
# Ignorar estes tipos de título (CODTIPTIT), ex.: 100,101,102,27
TIPOS_TITULO_IGNORAR=
# Ignorar estes parceiros (CODPARC). 4262 = REDECARD
PARCEIROS_IGNORAR=4262
